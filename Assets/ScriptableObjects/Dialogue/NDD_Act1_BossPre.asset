  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act1_BossPre
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 96d172d63ba0fd24a9311c021a76d3ca, type: 2}
    text: "Ch\xE0ng \u01A1i... bu\xF4ng tay \u0111i... \u0110\u1EEBng gi\u1EBFt th\xEAm
      ai n\u1EEFa... Th\xE2n x\xE1c thi\u1EBFp \u0111\xE3 m\u1EE5c n\xE1t, c\u1EDB
      sao ch\xE0ng c\u1EE9 b\u1EAFt thi\u1EBFp ph\u1EA3i nh\xECn th\u1EBF gi\u1EDBi
      n\xE0y kh\xF4 h\xE9o v\xEC m\xECnh?"
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 96d172d63ba0fd24a9311c021a76d3ca, type: 2}
    text: "S\u1ED1ng l\u1EA1i tr\xEAn n\xFAi x\u01B0\u01A1ng s\xF4ng m\xE1u... \u0111\xF3
      l\xE0 \xE1c qu\u1EF7, kh\xF4ng ph\u1EA3i l\xE0 con ng\u01B0\u1EDDi. Xin ng\u01B0\u1EDDi
      \u0111i \u0111\u01B0\u1EDDng, h\xE3y d\xF9ng \u0111ao ki\u1EBFm c\u1EE7a ng\u01B0\u01A1i,
      ch\u1EB7t \u0111\u1EE9t g\xF4ng c\xF9m cho phu qu\xE2n ta. Ch\xE0ng \u1EA5y...
      \u0111\xE3 qu\xE1 m\u1EC7t m\u1ECFi r\u1ED3i."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
