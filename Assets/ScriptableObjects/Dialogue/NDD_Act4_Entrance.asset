  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act4_Entrance
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: a1fb4955ce3327040812ea032ab79fdd, type: 2}
    text: "Gi\u1EBFt... r\xFAt... r\xFAt... N\xF3 b\u1EAFt ch\xFAng ta... ch\u1EA1y
      l\xF2 luy\u1EC7n... b\u1EB1ng sinh m\u1EC7nh..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6e4e438a5e4e2104ea05f9da0ef249ae, type: 2}
    text: "Kim Tr\u1EA5n Thi\xEAn Kh\xED \u0111\u01B0\u1EE3c d\xF9ng \u0111\u1EC3
      v\u1EADn h\xE0nh c\xE1i \u0111\u1ECBa ng\u1EE5c n\xE0y sao. K\u1EBB n\xE0o
      \u0111i\u1EC1u khi\u1EC3n l\xF5i m\xE1y?"
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: a1fb4955ce3327040812ea032ab79fdd, type: 2}
    text: "Nh\u1EA1c V\xF4 H\xE0... H\u1EAFn t\u1EEBng l\xE0 \u0111\u1EA1i t\u01B0\u1EDBng
      th\u1EE7 th\xE0nh... gi\u1EDD ch\u1EC9 l\xE0 m\u1ED9t c\u1ED7 m\xE1y ch\xE9m
      gi\u1EBFt... kh\xF4ng c\xF3 tim... \u0110\u1EEBng \u0111\u1EC3 kim kh\xED...
      \u0111\u1ED3ng h\xF3a m\u1EA1ch m\xE1u..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
