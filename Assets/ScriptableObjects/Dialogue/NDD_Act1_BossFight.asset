MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act1_BossFight
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 6840248a62acf894d94f30b413c0611e, type: 2}
    text: "L\u1EA1i m\u1ED9t k\u1EBB n\u1EEFa \u0111\u1EBFn n\u1ED9p m\u1EA1ng. Sinh
      c\u01A1 c\u1EE7a ng\u01B0\u01A1i r\u1EA5t tinh khi\u1EBFt. T\u1ED1t l\u1EAFm.
      L\xE0m ph\xE2n b\xF3n cho hoa c\u1EE7a n\xE0ng \u1EA5y \u0111i."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "H\u1EAFn d\u1EF1ng Khi\xEAn M\u1ED9c r\u1ED3i! T\u1EA5n c\xF4ng v\xE0o
      b\u1EA3n th\u1EC3 v\xF4 d\u1EE5ng th\xF4i. Nh\xECn 8 nh\xE1nh r\u1EC5 \u0111ang
      h\xFAt m\xE1u xung quanh k\xECa, ch\u1EB7t \u0111\u1EE9t ch\xFAng tr\u01B0\u1EDBc!"
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6840248a62acf894d94f30b413c0611e, type: 2}
    text: "K\u1EBB n\xE0o d\xE1m \u0111\u1EE5ng v\xE0o n\xE0ng! Ta s\u1EBD r\xFAt
      c\u1EA1n t\u1EE7y s\u1ED1ng c\u1EE7a ng\u01B0\u01A1i! Ch\u1EC9 c\u1EA7n n\xE0ng
      m\u1EDF m\u1EAFt nh\xECn ta m\u1ED9t l\u1EA7n n\u1EEFa!"
    autoAdvance: 1
    autoAdvanceDelay: 2
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6840248a62acf894d94f30b413c0611e, type: 2}
    text: "S\u1EAFp \u0111\u01B0\u1EE3c r\u1ED3i... Ch\xFAt n\u1EEFa th\xF4i! Uy\u1EC3n
      Nhi, \u0111\u1EEBng nh\xECn ta b\u1EB1ng \xE1nh m\u1EAFt \u0111\xF3! B\u1ECDn
      ch\xFAng ch\u1EC9 l\xE0 giun d\u1EBF! N\xE0ng m\u1EDBi l\xE0 c\u1EA3 th\u1EBF
      gi\u1EDBi c\u1EE7a ta!"
    autoAdvance: 1
    autoAdvanceDelay: 2
    onStartEvent: 
    onEndEvent: 
