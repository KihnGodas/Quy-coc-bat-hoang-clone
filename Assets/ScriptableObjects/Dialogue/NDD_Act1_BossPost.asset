  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act1_BossPost
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 6840248a62acf894d94f30b413c0611e, type: 2}
    text: "Nh\u01B0 Y\xEAn... Ta xin l\u1ED7i... Ta gi\u1EEF \u0111\u01B0\u1EE3c
      thi\xEAn h\u1EA1 cho \u0110\u1EA1o T\xF4n... nh\u01B0ng kh\xF4ng gi\u1EEF n\u1ED5i
      n\xE0ng... B\xE0n tay ta... b\u1EA9n qu\xE1 r\u1ED3i..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 96d172d63ba0fd24a9311c021a76d3ca, type: 2}
    text: "Kh\xF4ng sao... Ch\xFAng ta cu\u1ED1i c\xF9ng c\u0169ng \u0111\u01B0\u1EE3c
      ngh\u1EC9 ng\u01A1i r\u1ED3i. C\u1EA3m \u01A1n ch\xE0ng."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6840248a62acf894d94f30b413c0611e, type: 2}
    text: "Ph\u1EBF Linh C\u0103n.... Ng\u01B0\u01A1i r\u1EA5t gi\u1ED1ng ta n\u0103m
      \u0111\xF3. C\u1EA7m l\u1EA5y n\xF3. Ph\xE1 n\xE1t c\xE1i Thi\xEAn Kh\xF4ng
      Th\xE0nh ch\u1EBFt ti\u1EC7t kia. \u0110\u1EEBng... \u0111\u1EC3 m\u1EA5t ng\u01B0\u1EDDi
      ng\u01B0\u01A1i y\xEAu th\u01B0\u01A1ng nh\u1EA5t."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "M\u1ED9c Tr\u1EA5n Thi\xEAn Kh\xED \u0111\xE3 \u0111\u01B0\u1EE3c thu
      h\u1ED3i. \u0110i n\xE0o. Ph\xEDa tr\u01B0\u1EDBc c\xF2n \u0110\xF4ng H\u1EA3i
      C\u1EF1 Uy\xEAn \u0111ang ch\u1EDD."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
