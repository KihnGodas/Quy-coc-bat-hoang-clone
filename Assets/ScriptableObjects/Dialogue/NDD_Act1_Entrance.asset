  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act1_Entrance
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "Ng\u1EEDi th\u1EA5y m\xF9i g\xEC kh\xF4ng? M\xF9i c\u1EE7a s\u1EF1 s\u1ED1ng
      gi\u1EA3 t\u1EA1o. K\u1EBB cai qu\u1EA3n n\u01A1i n\xE0y \u0111ang d\xF9ng
      M\u1ED9c Tr\u1EA5n Thi\xEAn Kh\xED \u0111\u1EC3 c\u01B0\u1EDBp \u0111o\u1EA1t
      sinh c\u01A1 c\u1EE7a v\u1EA1n v\u1EADt d\u01B0\u1EDBi \u0111\xE1y v\u1EF1c,
      b\u01A1m ng\u01B0\u1EE3c l\xEAn tr\xEAn. C\u1EE9 m\u1ED7i h\u01A1i th\u1EDF
      c\u1EE7a ng\u01B0\u01A1i \u1EDF \u0111\xE2y, kinh m\u1EA1ch s\u1EBD b\u1ECB
      x\xE2m th\u1EF1c."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6e4e438a5e4e2104ea05f9da0ef249ae, type: 2}
    text: "K\u1EBB n\xE0o c\xF3 th\u1EC3 l\xE0m ra lo\u1EA1i \u0111\u1EA1i tr\u1EADn
      t\xE0 \xE1c th\u1EBF n\xE0y?"
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "Th\xF4i H\xE0n T\xF9ng. K\u1EBB \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi \u0111\u1EDDi
      x\u01B0ng t\u1EE5ng l\xE0 C\u1ED5 Th\u1EE5 T\xF4n Gi\u1EA3. T\u1EEBng l\xE0
      m\u1ED9t y s\u01B0 c\u1EE9u nh\xE2n \u0111\u1ED9 th\u1EBF. Th\u1EADt n\u1EF1c
      c\u01B0\u1EDDi."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
