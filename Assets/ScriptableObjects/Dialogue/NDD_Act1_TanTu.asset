  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Act1_TanTu
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: e29ee9f79ddb82b489b15394b5481455, type: 2}
    text: "Ti\u1EC3u h\u1EEFu... \u0111\u1EEBng \u0111i ti\u1EBFp... ph\xEDa tr\u01B0\u1EDBc
      kh\xF4ng c\xF3 \u0111\u01B0\u1EDDng s\u1ED1ng \u0111\xE2u... C\u1ED5 Th\u1EE5
      T\xF4n Gi\u1EA3 \u0111i\xEAn r\u1ED3i..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 6e4e438a5e4e2104ea05f9da0ef249ae, type: 2}
    text: "\xD4ng ta \u0111ang b\u1EA3o v\u1EC7 th\u1EE9 g\xEC \u1EDF trung t\xE2m
      \u0111\u1EA1i tr\u1EADn?"
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: e29ee9f79ddb82b489b15394b5481455, type: 2}
    text: "M\u1ED9t b\xF3ng ma... N\u0103m \u0111\xF3, th\xEA t\u1EED c\u1EE7a ng\xE0i
      \u1EA5y b\u1ECB Huy\u1EC1n Thi\xEAn \u0110\u1EA1o T\xF4n h\u1EA1 \u0111\u1ED9c
      th\u1EE7. \u0110\u1EC3 gi\u1EEF l\u1EA1i m\u1ED9t tia t\xE0n h\u1ED3n c\u1EE7a
      n\xE0ng, ng\xE0i \u1EA5y t\u1EF1 bi\u1EBFn m\xECnh th\xE0nh l\xF5i c\u1EE7a
      C\xE2y Th\u1EBF Gi\u1EDBi... h\xFAt m\xE1u c\u1EE7a ch\xFAng ta... v\u1EAFt
      ki\u1EC7t tinh hoa c\u1EE7a \u0111\u1EA5t tr\u1EDDi ch\u1EC9 \u0111\u1EC3 nu\xF4i
      m\u1ED9t n\u1EE5 hoa kh\xF4ng bao gi\u1EDD n\u1EDF..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: e29ee9f79ddb82b489b15394b5481455, type: 2}
    text: "Ng\xE0i \u1EA5y t\u1EEBng c\u1EE9u m\u1EA1ng ta... gi\u1EDD ta tr\u1EA3
      m\u1EA1ng cho ng\xE0i \u1EA5y... Gi\u1EBFt ng\xE0i \u1EA5y \u0111i... xin ng\u01B0\u01A1i..."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
