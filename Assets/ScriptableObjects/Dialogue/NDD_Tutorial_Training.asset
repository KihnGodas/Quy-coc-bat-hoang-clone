  m_Script: {fileID: 11500000, guid: 10388b5eb67ab074db119a7e57a34d2f, type: 3}
  m_Name: NDD_Tutorial_Training
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "Thi\xEAn \u0110\u1EA1o \u0111\xE3 v\u1EE1, th\xE2n x\xE1c ng\u01B0\u01A1i
      hi\u1EC7n t\u1EA1i qu\xE1 y\u1EBFu \u1EDBt \u0111\u1EC3 ch\u1ECBu \u0111\u1EF1ng
      lu\u1ED3ng ch\xE2n kh\xED n\xE0y. Th\u1EED v\u1EADn \u0111\u1ED9ng \u0111i.
      Nh\xECn k\u1EBB th\xF9 gi\u1EA3 l\u1EADp ph\xEDa tr\u01B0\u1EDBc k\xECa."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "T\u1ED1t. Gi\u1EDD th\u1EED d\u1ED3n linh l\u1EF1c v\xE0o \u0111\xF2n
      \u0111\xE1nh. D\xF9ng k\u1EF9 n\u0103ng \u0111\u1EC3 ph\xE1 v\u1EE1 l\u1EDBp
      gi\xE1p c\u1EE7a n\xF3."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
  - speaker: {fileID: 11400000, guid: 78d4e64e81e4bf94a9f05d8e01f098b2, type: 2}
    text: "C\u01A1 th\u1EC3 \u0111\xE3 quen d\u1EA7n r\u1ED3i. Chu\u1EA9n b\u1ECB
      \u0111i, m\xF9i sinh kh\xED c\u1EE7a ng\u01B0\u01A1i v\u1EEBa k\xE9o kh\xE1
      nhi\u1EC1u sinh v\u1EADt \u0111\u1EBFn \u0111\u1EA5y."
    autoAdvance: 0
    autoAdvanceDelay: 0
    onStartEvent: 
    onEndEvent: 
